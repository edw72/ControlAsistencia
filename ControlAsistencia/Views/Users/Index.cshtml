@model IEnumerable<ControlAsistencia.Models.User>
@{
    ViewData["Title"] = "Gestión de Usuarios del Sistema";
}

<div class="container py-4" style="max-width: 950px;">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            ✔ @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            ⚠️ @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom gap-3">
        <div>
            <h2 class="h3 fw-bold mb-0">⚙ Gestión de Usuarios del Sistema</h2>
            <span class="text-muted">Administra los accesos de supervisores y encargados de turno</span>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary fw-semibold px-3 py-2 rounded-3">
                ➕ Nuevo Usuario
            </a>
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary px-3 py-2 ms-2">
                ⬅ Volver al Panel
            </a>
        </div>
    </div>

    <!-- Tabla de Usuarios -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Nombre Completo</th>
                        <th>Usuario (Login)</th>
                        <th>Rol</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td class="fw-bold">@user.FullName</td>
                            <td><code>@user.Username</code></td>
                            <td>
                                @if (user.Role == "Admin")
                                {
                                    <span class="badge bg-primary px-3 py-2">Administrador</span>
                                }
                                else
                                {
                                    <span class="badge bg-info text-dark px-3 py-2">Supervisor</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-outline-primary" title="Editar datos o cambiar contraseña">
                                        ✏ Editar / Clave
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@user.Id" method="post" class="d-inline"
                                          onsubmit="return confirm('¿Está seguro de eliminar el acceso a este usuario?');">
                                        <button type="submit" class="btn btn-outline-danger" title="Eliminar acceso">
                                            🗑
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>