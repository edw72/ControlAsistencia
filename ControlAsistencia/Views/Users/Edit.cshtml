@model ControlAsistencia.Models.UserEditViewModel
@{
    ViewData["Title"] = "Editar Usuario";
}

<div class="container py-4" style="max-width: 600px;">
    <div class="card border-0 shadow-sm rounded-4 p-4">
        <h3 class="fw-bold mb-1">Editar Cuenta de Usuario</h3>
        <p class="text-muted mb-4">Modifica los datos o asigna una nueva contraseña</p>

        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="FullName" class="form-label fw-semibold"></label>
                <input asp-for="FullName" class="form-control form-control-lg" />
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Username" class="form-label fw-semibold"></label>
                <input asp-for="Username" class="form-control form-control-lg" />
                <span asp-validation-for="Username" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Role" class="form-label fw-semibold"></label>
                <select asp-for="Role" class="form-select form-select-lg">
                    <option value="Supervisor">Supervisor</option>
                    <option value="Admin">Administrador</option>
                </select>
                <span asp-validation-for="Role" class="text-danger small"></span>
            </div>

            <div class="mb-4 bg-light p-3 rounded-3 border">
                <label asp-for="NewPassword" class="form-label fw-semibold"></label>
                <input asp-for="NewPassword" class="form-control form-control-lg" placeholder="Dejar en blanco para mantener la actual" />
                <small class="text-muted d-block mt-1">Escribe solo si deseas cambiarle la contraseña a este usuario.</small>
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancelar</a>
                <button type="submit" class="btn btn-primary px-4 fw-bold">Actualizar Datos</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}