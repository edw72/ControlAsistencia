@model IEnumerable<ControlAsistencia.Models.AttendanceIncident>
@{
    ViewData["Title"] = "Bitácora de Novedades y Justificaciones";
    var employees = ViewBag.Employees as List<ControlAsistencia.Models.Employee> ?? new();
}

<div class="container-fluid py-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            ✔ @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom gap-3">
        <div>
            <h2 class="h3 fw-bold mb-0">Bitácora de Novedades y Justificaciones</h2>
            <span class="text-muted">Registro de llamadas, avisos de tardanza, citas médicas y situaciones especiales</span>
        </div>
        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary">
            ⬅ Volver al Panel Diario
        </a>
    </div>

    <!-- Barra de Filtros y Búsqueda -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-md-3">
                    <select name="employeeId" class="form-select">
                        <option value="">-- Todos los colaboradores --</option>
                        @foreach (var emp in employees)
                        {
                            <option value="@emp.Id" selected="@(ViewBag.SelectedEmployeeId == emp.Id)">
                                @emp.FullName (@emp.CardCode)
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <input type="date" name="fromDate" class="form-control" value="@ViewBag.FromDate" placeholder="Desde" />
                </div>
                <div class="col-md-2">
                    <input type="date" name="toDate" class="form-control" value="@ViewBag.ToDate" placeholder="Hasta" />
                </div>
                <div class="col-md-3">
                    <input type="text" name="search" class="form-control" placeholder="Buscar por palabra o motivo..." value="@ViewBag.Search" />
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100 fw-semibold">🔍 Buscar</button>
                    <a asp-action="Index" class="btn btn-outline-secondary" title="Limpiar">✖</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Tabla Histórica de Novedades -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Fecha Afectada</th>
                        <th>Colaborador</th>
                        <th>Tipo de Novedad</th>
                        <th>Detalle / Motivo Registrado</th>
                        <th>Anotado por</th>
                        <th>Fecha/Hora de la Llamada</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">
                                No se encontraron novedades o justificaciones con los filtros aplicados.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold">@item.Date.ToString("ddd dd/MM/yyyy")</td>
                                <td>
                                    <div class="fw-semibold">@item.Employee?.FullName</div>
                                    <small class="text-muted">ID: @item.Employee?.CardCode</small>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        @item.Category
                                    </span>
                                </td>
                                <td class="text-break" style="max-width: 380px;">
                                    @item.Detail
                                </td>
                                <td><span class="text-muted small">👤 @item.LoggedBy</span></td>
                                <td class="text-muted small">
                                    @item.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy hh:mm tt")
                                </td>
                                <td class="text-end">
                                    <form asp-action="Delete" method="post" class="d-inline"
                                          onsubmit="return confirm('¿Eliminar este registro de la bitácora?');">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar registro">
                                            🗑
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
