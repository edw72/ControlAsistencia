@model ControlAsistencia.Models.DashboardViewModel
@{
    ViewData["Title"] = "Panel de Control - Asistencia";
}

<style>
    /* Estilo compacto para que quepa en cualquier pantalla sin scroll horizontal */
    .dashboard-table th, .dashboard-table td {
        padding: 0.45rem 0.5rem !important;
        font-size: 0.85rem;
        vertical-align: middle;
    }
    .badge-status {
        font-size: 0.75rem;
        padding: 0.25rem 0.55rem;
        font-weight: 600;
    }
    .penalty-subtext {
        font-size: 0.73rem;
        display: block;
        line-height: 1.1;
    }
</style>

<div class="container-fluid py-3 px-4">
    <!-- Encabezado con Logo y Filtro de Fecha -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 pb-2 border-bottom gap-2">
        <div class="d-flex align-items-center gap-3">
            <img src="~/images/logo.png" alt="Logo" style="height: 48px; object-fit: contain;" />
            <div>
                <h3 class="h4 fw-bold mb-0">Control de Asistencia y Tiempos</h3>
                <span class="text-muted small">Supervisión en tiempo real y reporte diario</span>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <form method="get" class="d-flex gap-2">
                <input type="date" name="date" class="form-control form-control-sm"
                       value="@Model.SelectedDate.ToString("yyyy-MM-dd")" onchange="this.form.submit()" />
            </form>
            <a href="/Kiosk" target="_blank" class="btn btn-outline-primary btn-sm fw-semibold">🖥 Kiosco</a>
            <button class="btn btn-primary btn-sm" onclick="location.reload();">🔄 Actualizar</button>
        </div>
    </div>

    <!-- KPIs Superiores Compactos -->
    <div class="row g-2 mb-3">
        <div class="col-6 col-md">
            <div class="card border-0 shadow-sm rounded-3 border-start border-success border-4 p-2">
                <span class="text-muted fw-semibold" style="font-size: 0.72rem;">🟢 LABORANDO</span>
                <h4 class="fw-bold mt-1 mb-0 text-success">@Model.WorkingCount</h4>
            </div>
        </div>
        <div class="col-6 col-md">
            <div class="card border-0 shadow-sm rounded-3 border-start border-warning border-4 p-2">
                <span class="text-muted fw-semibold" style="font-size: 0.72rem;">☕ EN CAFÉ</span>
                <h4 class="fw-bold mt-1 mb-0 text-warning">@Model.CoffeeCount</h4>
            </div>
        </div>
        <div class="col-6 col-md">
            <div class="card border-0 shadow-sm rounded-3 border-start border-info border-4 p-2">
                <span class="text-muted fw-semibold" style="font-size: 0.72rem;">🍲 EN ALMUERZO</span>
                <h4 class="fw-bold mt-1 mb-0 text-info">@Model.LunchCount</h4>
            </div>
        </div>
        <div class="col-6 col-md">
            <div class="card border-0 shadow-sm rounded-3 border-start border-dark border-4 p-2">
                <span class="text-muted fw-semibold" style="font-size: 0.72rem;">🚶 EN DILIGENCIA</span>
                <h4 class="fw-bold mt-1 mb-0 text-dark">@Model.PersonalCount</h4>
            </div>
        </div>
        <div class="col-6 col-md">
            <div class="card border-0 shadow-sm rounded-3 border-start border-secondary border-4 p-2">
                <span class="text-muted fw-semibold" style="font-size: 0.72rem;">🔴 FUERA</span>
                <h4 class="fw-bold mt-1 mb-0 text-secondary">@Model.OutCount</h4>
            </div>
        </div>
    </div>

    <!-- Tabla Compacta Sin Scroll Horizontal -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive" style="overflow-x: auto;">
            <table class="table table-hover align-middle mb-0 dashboard-table">
                <thead class="table-light">
                    <tr>
                        <th style="min-width: 160px;">Empleado</th>
                        <th class="text-center" style="width: 105px;">Estado</th>
                        <th style="width: 110px;">Entrada</th>
                        <th style="width: 110px;">Salida</th>
                        <th style="width: 85px;">Café</th>
                        <th style="width: 95px;">Almuerzo</th>
                        <th style="width: 80px;">Dilig.</th>
                        <th style="width: 95px;">Descuento</th>
                        <th style="width: 105px;">Extras</th>
                        <th style="width: 85px;">Efectivas</th>
                        <th class="text-end" style="width: 105px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var emp in Model.Employees)
                    {
                        // Abreviación de estados para ahorrar espacio
                        string shortStatus = emp.CurrentStatus switch
                        {
                            "Laborando" => "🟢 Activo",
                            "Jornada Finalizada" => "🔴 Fin",
                            "En Café" => "☕ Café",
                            "En Almuerzo" => "🍲 Almuerzo",
                            "En Diligencia" => "🚶 Diligencia",
                            "Sin Ingreso" => "⚪ Ausente",
                            "Día Libre / Feriado" => "🎉 Feriado",
                            "🎂 Libre por Cumpleaños" => "🎂 Cumple",
                            _ => emp.CurrentStatus
                        };

                        <tr>
                            <!-- 1. Empleado y Novedad -->
                            <td>
                                <div class="fw-bold text-truncate" style="max-width: 175px;">
                                    @emp.FullName
                                    @if (!string.IsNullOrEmpty(emp.TodayIncidentDetail))
                                    {
                                        <span class="badge bg-warning text-dark border ms-1" title="@emp.TodayIncidentCategory: @emp.TodayIncidentDetail">
                                            📝
                                        </span>
                                    }
                                </div>
                                <small class="text-muted">#@emp.CardCode</small>
                            </td>

                            <!-- 2. Estado Compacto -->
                            <td class="text-center">
                                <span class="badge @emp.StatusBadgeClass badge-status">
                                    @shortStatus
                                </span>
                            </td>

                            <!-- 3. Entrada + Tardanza combinadas -->
                            <td>
                                <div class="fw-semibold">@emp.ClockInTime</div>
                                @if (emp.LateMinutes > 0)
                                {
                                    <span class="text-danger fw-bold penalty-subtext">+@emp.LateMinutes m tardía</span>
                                }
                            </td>

                            <!-- 4. Salida + Salida Anticipada combinadas -->
                            <td>
                                <div class="fw-semibold">@emp.ClockOutTime</div>
                                @if (emp.EarlyDepartureMinutes > 0)
                                {
                                    if (emp.IsEarlyDepartureWaived)
                                    {
                                        <span class="text-success fw-bold penalty-subtext" title="Justificado: @emp.EarlyDepartureReason">
                                            ✔ Con goce
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-danger fw-bold penalty-subtext">
                                            -@((emp.EarlyDepartureMinutes / 60))h @((emp.EarlyDepartureMinutes % 60))m
                                        </span>
                                    }
                                }
                            </td>

                            <!-- 5. Café (15m) -->
                            <td>
                                <span>@emp.CoffeeMinutes m</span>
                                @if (emp.ExcessCoffeeMinutes > 0)
                                {
                                    <span class="text-danger fw-bold penalty-subtext">(+@emp.ExcessCoffeeMinutes m)</span>
                                }
                            </td>

                            <!-- 6. Almuerzo -->
                            <td>
                                <span>@emp.LunchMinutes m</span>
                                @if (emp.ExcessLunchMinutes > 0)
                                {
                                    <span class="text-danger fw-bold penalty-subtext">(+@emp.ExcessLunchMinutes m)</span>
                                }
                            </td>

                            <!-- 7. Diligencias -->
                            <td>
                                @if (emp.PersonalErrandMinutes > 0)
                                {
                                    <span class="text-danger fw-bold">@emp.PersonalErrandMinutes m</span>
                                }
                                else
                                {
                                    <span class="text-muted">0m</span>
                                }
                            </td>

                            <!-- 8. Total Descuento -->
                            <td>
                                @if (emp.TotalExcessMinutes > 0)
                                {
                                    <span class="text-danger fw-bold">-@emp.TotalExcessMinutes m</span>
                                }
                                else
                                {
                                    <span class="text-muted">0m</span>
                                }
                            </td>

                            <!-- 9. Horas Extras Unificadas -->
                            <td>
                                @if (emp.HolidayOvertimeMinutes > 0)
                                {
                                    <span class="text-primary fw-bold" title="Domingo / Feriado al 100%">
                                        🎉 +@emp.FormattedHolidayOvertime
                                    </span>
                                }
                                else if (emp.RegularOvertimeMinutes > 0)
                                {
                                    <span class="text-success fw-bold">
                                        +@emp.FormattedRegularOvertime
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">0m</span>
                                }
                            </td>

                            <!-- 10. Horas Efectivas -->
                            <td>
                                <span class="fw-bold text-dark">@emp.NetWorkingHours</span>
                            </td>

                            <!-- 11. Acciones: Solo Iconos con Tooltip -->
                            <td class="text-end text-nowrap">
                                <div class="btn-group btn-group-sm">
                                    <button type="button" class="btn btn-outline-info"
                                            data-bs-toggle="modal" data-bs-target="#modalNovedad-@emp.EmployeeId"
                                            title="Registrar llamada / Novedad">
                                        💬
                                    </button>
                                    <a asp-controller="Adjustments" asp-action="Index"
                                       asp-route-employeeId="@emp.EmployeeId"
                                       asp-route-date="@Model.SelectedDate.ToString("yyyy-MM-dd")"
                                       class="btn btn-outline-primary"
                                       title="Corregir o ajustar marcas">
                                        🛠
                                    </a>
                                    <a asp-action="BiweeklyReport" asp-route-employeeId="@emp.EmployeeId"
                                       class="btn btn-outline-dark"
                                       title="Ver liquidación quincenal">
                                        📑
                                    </a>
                                </div>

                                <!-- Modal de Novedad Rápida -->
                                <div class="modal fade text-start" id="modalNovedad-@emp.EmployeeId" tabindex="-1">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content rounded-4 border-0 shadow">
                                            <form asp-controller="Incidents" asp-action="CreateQuick" method="post">
                                                <div class="modal-header border-0 pb-0">
                                                    <h5 class="modal-title fw-bold">Novedad: @emp.FullName</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <input type="hidden" name="employeeId" value="@emp.EmployeeId" />
                                                    <input type="hidden" name="date" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
                                                    <input type="hidden" name="returnUrl" value="/Dashboard?date=@Model.SelectedDate.ToString("yyyy-MM-dd")" />

                                                    <div class="mb-3">
                                                        <label class="form-label fw-semibold">Tipo de Novedad</label>
                                                        <select name="category" class="form-select">
                                                            <option value="Llegada Tardía Avisada">Llegada Tardía Avisada</option>
                                                            <option value="Problema de Transporte / Uber">Problema de Transporte / Uber</option>
                                                            <option value="Cita Médica">Cita Médica</option>
                                                            <option value="Permiso Personal / Trámite">Permiso Personal / Trámite</option>
                                                            <option value="Emergencia Familiar">Emergencia Familiar</option>
                                                            <option value="Otro">Otro</option>
                                                        </select>
                                                    </div>

                                                    <div class="form-check form-switch mb-3 p-3 bg-light rounded-3 border">
                                                        <input class="form-check-input ms-0 me-2" type="checkbox" name="waiveEarlyDeparture" value="true" id="chkWaive-@emp.EmployeeId">
                                                        <label class="form-check-label fw-bold text-success" for="chkWaive-@emp.EmployeeId">
                                                            ⚖ Justificar con Goce de Sueldo (NO descontar tiempo)
                                                        </label>
                                                    </div>

                                                    <div class="mb-3">
                                                        <label class="form-label fw-semibold">Detalle o Motivo</label>
                                                        <textarea name="detail" class="form-control" rows="3"
                                                              placeholder="Ej: Llamó avisando demora..." required></textarea>
                                                    </div>
                                                </div>
                                                <div class="modal-footer border-0">
                                                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                                                    <button type="submit" class="btn btn-primary btn-sm fw-bold">💾 Guardar</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>