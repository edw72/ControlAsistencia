@model ControlAsistencia.Models.BiweeklyReportViewModel
@{
    ViewData["Title"] = "Liquidación de Asistencia - " + Model.FullName;
}

<style>
    @@media print {
        .no-print {
            display: none !important;
        }

        body {
            background: #fff;
            font-size: 9pt;
        }

        .card {
            border: none !important;
            box-shadow: none !important;
        }

        table {
            font-size: 8pt !important;
        }

        th, td {
            padding: 4px 6px !important;
        }
    }
</style>

<div class="container py-4">
    <!-- MENSAJES DE ESTADO DE ENVÍO -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            ✔ @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            ⚠️ @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Barra de Filtros y Acciones -->
    <div class="d-flex justify-content-between align-items-center mb-4 no-print gap-3 flex-wrap">
        <a asp-action="Index" class="btn btn-outline-secondary">⬅ Volver al Panel</a>

        <form method="get" class="d-flex align-items-center gap-2">
            <input type="hidden" name="employeeId" value="@Model.EmployeeId" />
            <select name="quincena" class="form-select form-select-sm">
                <option value="1" selected="@(ViewBag.SelectedQuincena == 1)">1ra Quincena (Corte al 14)</option>
                <option value="2" selected="@(ViewBag.SelectedQuincena == 2)">2da Quincena (Día 15 al penúltimo día)</option>
            </select>
            <select name="month" class="form-select form-select-sm">
                @for (int m = 1; m <= 12; m++)
                {
                    <option value="@m" selected="@(ViewBag.SelectedMonth == m)">
                        @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m).ToUpper()
                    </option>
                }
            </select>
            <button type="submit" class="btn btn-sm btn-primary">Filtrar</button>
        </form>

        <div class="d-flex gap-2">
            <form asp-action="SendBiweeklyEmail" method="post" class="d-inline"
                  onsubmit="return confirm('¿Enviar por correo esta liquidación con el Excel adjunto al colaborador?');">
                <input type="hidden" name="employeeId" value="@Model.EmployeeId" />
                <input type="hidden" name="year" value="@ViewBag.SelectedYear" />
                <input type="hidden" name="month" value="@ViewBag.SelectedMonth" />
                <input type="hidden" name="quincena" value="@ViewBag.SelectedQuincena" />
                <button type="submit" class="btn btn-primary fw-bold">
                    📧 Enviar por Correo
                </button>
            </form>

            <a asp-action="ExportBiweeklyToExcel"
               asp-route-employeeId="@Model.EmployeeId"
               asp-route-year="@ViewBag.SelectedYear"
               asp-route-month="@ViewBag.SelectedMonth"
               asp-route-quincena="@ViewBag.SelectedQuincena"
               class="btn btn-success fw-bold">
                📗 Descargar Excel
            </a>
            <button onclick="window.print()" class="btn btn-outline-secondary fw-bold">
                🖨 Imprimir
            </button>
        </div>
    </div>

    <!-- DOCUMENTO FORMAL -->
    <div class="card p-4 border shadow-sm rounded-4">
        <div class="row border-bottom pb-3 mb-3 align-items-center">
            <div class="col-2 text-start">
                <img src="~/images/logo.png" alt="Logo" style="height: 60px; object-fit: contain;" />
            </div>
            <div class="col-5">
                <h3 class="fw-bold mb-1">LIQUIDACIÓN DE ASISTENCIA</h3>
                <h5 class="text-secondary mb-1">@Model.PeriodTitle</h5>
                <p class="mb-0 text-muted small">
                    Políticas: @(Model.HasUnifiedLunch ? "Almuerzo Unificado: 60m (L-V) / 45m (Sáb) - Sin café" : "Café: 15m | Almuerzo: 45m") | Diligencias: 100%
                </p>
            </div>
            <div class="col-5 text-end">
                <h4 class="fw-bold text-primary mb-1">@Model.FullName</h4>
                <p class="text-muted mb-0">
                    Cédula: <strong>@(string.IsNullOrWhiteSpace(Model.Identification) ? Model.CardCode : Model.Identification)</strong>
                    @if (Model.MonthlySalary > 0)
                    {
                        <span class="ms-2">| Salario: <strong>₡ @Model.MonthlySalary.ToString("N2")</strong></span>
                    }
                </p>
                <small class="text-muted">@Model.StartDate.ToString("dd/MM/yyyy") al @Model.EndDate.ToString("dd/MM/yyyy")</small>
            </div>
        </div>

        <!-- Tabla con Extras Diurnas y Nocturnas Separadas -->
        <table class="table table-bordered align-middle mb-4">
            <thead class="table-light">
                <tr class="text-center">
                    <th>Fecha</th>
                    <th>Entrada</th>
                    <th>Tardanza</th>
                    <th>Salida</th>
                    <th>Salida Anticipada</th>
                    <th>Café Real</th>
                    <th>Almuerzo Real</th>
                    <th>Diligencias</th>
                    <th>Total Descuento</th>
                    <th>☀️ Extras Diurnas</th>
                    <th>🌙 Extras Nocturnas</th>
                    <th>🎉 Extras Dom/Fer.</th>
                    <th>Efectivas</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Days.Any())
                {
                    <tr>
                        <td colspan="13" class="text-center text-muted py-4">No se registran marcas en este periodo.</td>
                    </tr>
                }
                else
                {
                    @foreach (var d in Model.Days)
                    {
                        int allowedLunch = (Model.HasUnifiedLunch && d.Date.DayOfWeek != DayOfWeek.Saturday) ? 60 : 45;
                        int allowedCoffee = (Model.HasUnifiedLunch && d.Date.DayOfWeek != DayOfWeek.Saturday) ? 0 : 15;

                        <tr class="text-center">
                            <td class="fw-bold text-start ps-3">@d.Date.ToString("ddd dd/MM/yyyy")</td>
                            <td>@d.ClockIn</td>

                            <!-- Tardanza -->
                            <td>
                                @if (d.LateMinutes > 0)
                                {
                                    <span class="text-danger fw-bold">+@d.LateMinutes m</span>
                                }
                                else
                                {
                                    <span class="text-muted">0m</span>
                                }
                            </td>

                            <td>@d.ClockOut</td>

                            <!-- Salida Anticipada -->
                            <td>
                                @if (d.EarlyDepartureMinutes > 0)
                                {
                                    if (d.IsEarlyDepartureWaived)
                                    {
                                        <span class="text-success small fw-bold">0m (Con goce)</span>
                                    }
                                    else
                                    {
                                        <span class="text-danger fw-bold">-@((d.EarlyDepartureMinutes / 60))h @((d.EarlyDepartureMinutes % 60))m</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">0m</span>
                                }
                            </td>

                            <!-- Café -->
                            <td>
                                <span>@d.CoffeeMinutes m</span>
                                @if (d.CoffeeMinutes > allowedCoffee)
                                {
                                    <span class="text-danger fw-bold ms-1">(+@(d.CoffeeMinutes - allowedCoffee)m)</span>
                                }
                            </td>

                            <!-- Almuerzo -->
                            <td>
                                <span>@d.LunchMinutes m</span>
                                @if (d.LunchMinutes > allowedLunch)
                                {
                                    <span class="text-danger fw-bold ms-1">(+@(d.LunchMinutes - allowedLunch)m)</span>
                                }
                            </td>

                            <!-- Diligencias -->
                            <td>
                                @if (d.PersonalErrandMinutes > 0)
                                {
                                    <span class="text-danger fw-bold">@d.PersonalErrandMinutes m</span>
                                }
                                else
                                {
                                    <span class="text-muted">0m</span>
                                }
                            </td>

                            <!-- Total Descuento -->
                            <td>
                                @if (d.ExcessMinutes > 0)
                                {
                                    <span class="text-danger fw-bold">-@d.ExcessMinutes min</span>
                                }
                                else
                                {
                                    <span class="text-muted">0m</span>
                                }
                            </td>

                            <!-- ☀️ EXTRAS DIURNAS (Antes de 7:00 PM) -->
                            <td>
                                @if (d.DayOvertimeMinutes > 0)
                                {
                                    <span class="text-success fw-bold">+@((d.DayOvertimeMinutes / 60))h @((d.DayOvertimeMinutes % 60))m</span>
                                }
                                else
                                {
                                    <span class="text-muted">0m</span>
                                }
                            </td>

                            <!-- 🌙 EXTRAS NOCTURNAS (Después de 7:00 PM) -->
                            <td>
                                @if (d.NightOvertimeMinutes > 0)
                                {
                                    <span class="text-success fw-bold">+@((d.NightOvertimeMinutes / 60))h @((d.NightOvertimeMinutes % 60))m</span>
                                }
                                else
                                {
                                    <span class="text-muted">0m</span>
                                }
                            </td>

                            <!-- 🎉 EXTRAS DOMINGOS / FERIADOS (100% extraordinario) -->
                            <td>
                                @if (d.HolidayOvertimeMinutes > 0)
                                {
                                    <span class="text-primary fw-bold">+@((d.HolidayOvertimeMinutes / 60))h @((d.HolidayOvertimeMinutes % 60))m</span>
                                }
                                else
                                {
                                    <span class="text-muted">0m</span>
                                }
                            </td>

                            <td class="fw-semibold">@d.EffectiveHours</td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        <!-- Resumen Financiero Tipográfico -->
        <div class="row g-3 bg-light p-3 rounded-3 mb-4 border">
            <div class="col-md-6 border-end">
                <span class="text-muted small fw-bold">DESGLOSE DE DEDUCCIONES APLICADAS:</span>
                <ul class="list-unstyled mb-2 mt-1 small">
                    <li>⏱ Tardanzas de entrada: <span class="text-danger fw-bold">@Model.TotalLateMinutes min</span></li>
                    <li>🚪 Salidas anticipadas no justif.: <span class="text-danger fw-bold">@Model.TotalEarlyDepartureMinutes min</span></li>
                    <li>☕ Exceso café: <span class="text-danger fw-bold">@Model.TotalExcessCoffeeMinutes min</span></li>
                    <li>🍲 Exceso almuerzo (@(Model.HasUnifiedLunch ? ">60 min" : ">45 min")): <span class="text-danger fw-bold">@Model.TotalExcessLunchMinutes min</span></li>
                    <li>🚶 Diligencias personales (100%): <span class="text-danger fw-bold">@Model.TotalPersonalErrandMinutes min</span></li>
                </ul>
                <h5 class="fw-bold text-danger mb-0">
                    TOTAL A DEDUCIR: @Model.FormattedTotalExcess
                    @if (Model.DeductionAmount > 0)
                    {
                        <span>(₡ @Model.DeductionAmount.ToString("N2"))</span>
                    }
                </h5>
            </div>
            <div class="col-md-6 ps-md-4">
                <span class="text-muted small fw-bold">RESUMEN DE TIEMPO EXTRA LABORADO:</span>
                <ul class="list-unstyled mb-2 mt-1 small">
                    <li>☀️ Extras Diurnas (hasta 7pm): <span class="text-success fw-bold">@((Model.TotalDayOvertimeMinutes / 60))h @((Model.TotalDayOvertimeMinutes % 60))m @(Model.DayOvertimeAmount > 0 ? $"(₡ {Model.DayOvertimeAmount:N2})" : "")</span></li>
                    <li>🌙 Extras Nocturnas (después 7pm): <span class="text-success fw-bold">@((Model.TotalNightOvertimeMinutes / 60))h @((Model.TotalNightOvertimeMinutes % 60))m @(Model.NightOvertimeAmount > 0 ? $"(₡ {Model.NightOvertimeAmount:N2})" : "")</span></li>
                    <li>🎉 Extras Domingos y Feriados (Pagadas en fecha): <span class="text-primary fw-bold">@Model.FormattedHolidayOvertime</span></li>
                </ul>
                <h5 class="fw-bold text-success mb-0 mt-3">TOTAL EXTRAS EN NÓMINA: ₡ @Model.TotalOvertimeAmount.ToString("N2")</h5>
            </div>
        </div>

        <!-- Firmas -->
        <div class="row mt-5 pt-4 text-center">
            <div class="col-6">
                <div class="border-top border-dark mx-auto" style="width: 70%;"></div>
                <p class="mt-2 fw-semibold mb-0">Recursos Humanos / Nómina</p>
            </div>
            <div class="col-6">
                <div class="border-top border-dark mx-auto" style="width: 70%;"></div>
                <p class="mt-2 fw-semibold mb-0">Firma del Colaborador</p>
            </div>
        </div>
    </div>
</div>