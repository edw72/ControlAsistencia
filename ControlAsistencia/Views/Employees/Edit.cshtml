@model ControlAsistencia.Models.Employee
@{
    ViewData["Title"] = "Editar Colaborador";
}

<div class="container py-4" style="max-width: 650px;">
    <div class="card border-0 shadow-sm rounded-4 p-4">
        <h3 class="fw-bold mb-1">Editar Datos del Empleado</h3>
        <p class="text-muted mb-4">Modifique la información asignada al empleado</p>

        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CreatedAt" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="FullName" class="form-label fw-semibold"></label>
                <input asp-for="FullName" class="form-control form-control-lg" />
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label fw-semibold">Correo Electrónico (Para envío de nómina)</label>
                <input asp-for="Email" type="email" class="form-control form-control-lg" placeholder="ejemplo@correo.com" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="Identification" class="form-label fw-semibold">Número de Cédula</label>
                    <input asp-for="Identification" class="form-control form-control-lg" placeholder="Ej: 1-1234-0567" />
                    <span asp-validation-for="Identification" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="MonthlySalary" class="form-label fw-semibold">Salario Mensual Bruto (₡)</label>
                    <div class="input-group input-group-lg">
                        <span class="input-group-text">₡</span>
                        <input asp-for="MonthlySalary" type="number" step="0.01" class="form-control" placeholder="0.00" />
                    </div>
                    <span asp-validation-for="MonthlySalary" class="text-danger small"></span>
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="BirthDate" class="form-label fw-semibold">Fecha de Cumpleaños</label>
                <input asp-for="BirthDate" type="date" class="form-control form-control-lg" />
                <small class="text-muted">Si cae domingo, el sistema trasladará el día libre al lunes siguiente automáticamente.</small>
            </div>

            <div class="mb-3">
                <label asp-for="CardCode" class="form-label fw-semibold">Código Tarjeta RFID o QR</label>
                <input asp-for="CardCode" class="form-control form-control-lg" />
                <span asp-validation-for="CardCode" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Pin" class="form-label fw-semibold">PIN Numérico</label>
                <input asp-for="Pin" class="form-control form-control-lg" placeholder="••••" />
                <span asp-validation-for="Pin" class="text-danger small"></span>
            </div>

            <div class="form-check form-switch mb-4">
                <input class="form-check-input" type="checkbox" asp-for="IsActive">
                <label class="form-check-label fw-semibold" asp-for="IsActive">¿Empleado Activo para Marcar?</label>
            </div>
            <div class="form-check form-switch mb-3">
                <input class="form-check-input" type="checkbox" asp-for="HasUnifiedLunch">
                <label class="form-check-label fw-semibold" asp-for="HasUnifiedLunch">
                    Pausa Unificada (60 min Almuerzo - Omite Café matutino)
                </label>
            </div>

            <div class="d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancelar</a>
                <button type="submit" class="btn btn-primary px-4 fw-bold">Actualizar Datos</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}