@model IEnumerable<ControlAsistencia.Models.Employee>
@{
    ViewData["Title"] = "Gestión de Empleados";
}

<div class="container py-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            ✔ @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom gap-3">
        <div>
            <h2 class="h3 fw-bold mb-0">Gestión de Empleados</h2>
            <span class="text-muted">Administración de tarjetas RFID, códigos QR y PINs de acceso</span>
        </div>
        <a asp-action="Create" class="btn btn-primary fw-semibold px-3 py-2 rounded-3">
            ➕ Registrar Nuevo Empleado
        </a>
    </div>

    <!-- Buscador -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-md-5">
                    <input type="text" name="search" class="form-control"
                           placeholder="Buscar por nombre o código..." value="@ViewBag.CurrentSearch" />
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-dark w-100">🔍 Buscar</button>
                </div>
                @if (!string.IsNullOrEmpty(ViewBag.CurrentSearch))
                {
                    <div class="col-md-2">
                        <a asp-action="Index" class="btn btn-outline-secondary w-100">Limpiar</a>
                    </div>
                }
            </form>
        </div>
    </div>

    <!-- Tabla de Empleados -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Nombre Completo</th>
                        <th>Código (RFID / QR)</th>
                        <th>PIN</th>
                        <th>Estado</th>
                        <th>Fecha Registro</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="@(!item.IsActive ? "opacity-50" : "")">
                            <td class="fw-bold">@item.FullName</td>
                            <td><span class="badge bg-light text-dark border fs-6">@item.CardCode</span></td>
                            <td><code>@(string.IsNullOrEmpty(item.Pin) ? "Sin PIN" : "••••")</code></td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success px-2 py-1">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger px-2 py-1">Inactivo</span>
                                }
                            </td>
                            <td class="text-muted">@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                            <td class="text-end">
                                <div class="btn-group">
                                    <a asp-action="Badge" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="Imprimir Carné con QR">
                                        🪪 Carné QR
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Editar">
                                        ✏ Editar
                                    </a>
                                    <form asp-action="ToggleStatus" asp-route-id="@item.Id" method="post" class="d-inline"
                                          onsubmit="return confirm('¿Está seguro de cambiar el estado de este colaborador?');">
                                        <button type="submit" class="btn btn-sm @(item.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                            @(item.IsActive ? "Desactivar" : "Activar")
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
