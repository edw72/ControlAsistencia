@model ControlAsistencia.Models.Employee
@{
    ViewData["Title"] = "Registrar Colaborador";
}

<div class="container py-4" style="max-width: 650px;">
    <div class="card border-0 shadow-sm rounded-4 p-4">
        <h3 class="fw-bold mb-1">Registrar Nuevo Empleado</h3>
        <p class="text-muted mb-4">Complete los datos para habilitar el acceso al reloj checador</p>

        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="FullName" class="form-label fw-semibold"></label>
                <input asp-for="FullName" class="form-control form-control-lg" placeholder="Ej: María Fernández" autofocus />
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="BirthDate" class="form-label fw-semibold">Fecha de Cumpleaños</label>
                <input asp-for="BirthDate" type="date" class="form-control form-control-lg" />
                <small class="text-muted">Si cae domingo, el sistema trasladará el día libre al lunes siguiente automáticamente.</small>
            </div>

            <div class="mb-3">
                <label asp-for="CardCode" class="form-label fw-semibold">Código de Tarjeta RFID o QR</label>
                <input asp-for="CardCode" class="form-control form-control-lg" placeholder="Ej: 1003 o pase la tarjeta RFID..." />
                <small class="text-muted d-block mt-1">Este es el número único que leerá el escáner o el lector RFID.</small>
                <span asp-validation-for="CardCode" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Pin" class="form-label fw-semibold">PIN Numérico de Respaldo</label>
                <input asp-for="Pin" type="password" maxlength="6" class="form-control form-control-lg" placeholder="Ej: 4321" />
                <small class="text-muted d-block mt-1">De 4 a 6 números, por si olvida su carné físico.</small>
                <span asp-validation-for="Pin" class="text-danger small"></span>
            </div>
            <div class="form-check form-switch mb-4">
                <input class="form-check-input" type="checkbox" asp-for="HasUnifiedLunch">
                <label class="form-check-label fw-semibold" asp-for="HasUnifiedLunch">
                    Pausa Unificada (60 min Almuerzo - Omite Café matutino)
                </label>
            </div>

            <div class="d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancelar</a>
                <button type="submit" class="btn btn-primary px-4 fw-bold">Guardar Empleado</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
