@model ControlAsistencia.Models.AdjustmentViewModel
@{
    ViewData["Title"] = "Ajustar Marcas - " + Model.EmployeeName;
}

<div class="container py-4">
    <!-- Mensajes de Estado -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            ✔ @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            ⚠️ @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Encabezado con Datos del Empleado -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom gap-3">
        <div>
            <h2 class="h3 fw-bold mb-1">Ajuste Manual de Marcas</h2>
            <p class="text-muted mb-0">
                Colaborador: <strong class="text-primary">@Model.EmployeeName</strong> (ID: @Model.CardCode) |
                Fecha: <strong>@Model.Date.ToString("dddd dd/MM/yyyy")</strong>
            </p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Dashboard" asp-action="Index" asp-route-date="@Model.Date.ToString("yyyy-MM-dd")"
               class="btn btn-outline-secondary fw-semibold">
                ⬅ Volver al Panel Diario
            </a>
        </div>
    </div>

    <div class="row g-4">
        <!-- Columna Izquierda: Marcas Actuales del Día -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-white py-3 border-0">
                    <h5 class="card-title fw-bold mb-0">Marcas Registradas en el Día</h5>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Tipo de Evento</th>
                                <th>Hora</th>
                                <th>Notas / Auditoría</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Records.Any())
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-4">
                                        No hay marcas registradas en este día.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var r in Model.Records)
                                {
                                    <tr>
                                        <td>
                                            <span class="badge @r.BadgeClass px-2 py-1">@r.TypeName</span>
                                        </td>
                                        <td class="fw-bold fs-6">@r.FormattedTime</td>
                                        <td>
                                            <small class="text-muted">@(string.IsNullOrEmpty(r.Note) ? "—" : r.Note)</small>
                                        </td>
                                        <td class="text-end">
                                            <!-- Botón Editar Hora -->
                                            <button type="button" class="btn btn-sm btn-outline-primary me-1"
                                                    data-bs-toggle="modal" data-bs-target="#editModal-@r.Id" title="Corregir Hora">
                                                ✏
                                            </button>

                                            <!-- Botón Eliminar Marca -->
                                            <form asp-action="DeletePunch" method="post" class="d-inline"
                                                  onsubmit="return confirm('¿Seguro que desea eliminar esta marca?');">
                                                <input type="hidden" name="recordId" value="@r.Id" />
                                                <input type="hidden" name="employeeId" value="@Model.EmployeeId" />
                                                <input type="hidden" name="date" value="@Model.Date.ToString("yyyy-MM-dd")" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar Marca">
                                                    🗑
                                                </button>
                                            </form>

                                            <!-- Modal de Edición de Hora -->
                                            <div class="modal fade text-start" id="editModal-@r.Id" tabindex="-1">
                                                <div class="modal-dialog modal-dialog-centered">
                                                    <div class="modal-content rounded-4 border-0 shadow">
                                                        <form asp-action="EditPunch" method="post">
                                                            <div class="modal-header border-0">
                                                                <h5 class="modal-title fw-bold">Corregir Hora: @r.TypeName</h5>
                                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                            </div>
                                                            <div class="modal-body">
                                                                <input type="hidden" name="recordId" value="@r.Id" />
                                                                <input type="hidden" name="employeeId" value="@Model.EmployeeId" />
                                                                <input type="hidden" name="date" value="@Model.Date.ToString("yyyy-MM-dd")" />

                                                                <div class="mb-3">
                                                                    <label class="form-label fw-semibold">Nueva Hora</label>
                                                                    <input type="time" name="time" class="form-control form-control-lg"
                                                                           value="@r.LocalTime.ToString("HH:mm")" required />
                                                                </div>
                                                                <div class="mb-3">
                                                                    <label class="form-label fw-semibold">Justificación / Motivo</label>
                                                                    <input type="text" name="justification" class="form-control"
                                                                           placeholder="Ej: Empleado olvidó marcar a tiempo por atender proveedor" required />
                                                                </div>
                                                            </div>
                                                            <div class="modal-footer border-0">
                                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                                                <button type="submit" class="btn btn-primary fw-bold">Guardar Corrección</button>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Columna Derecha: Formulario para Agregar Marca Faltante -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <h5 class="fw-bold mb-3">➕ Agregar Marca Olvidada</h5>
                <p class="text-muted small mb-4">
                    Inserte un evento que el empleado no registró en el Kiosco. El sistema recalculará automáticamente las horas efectivas y excesos.
                </p>

                <form asp-action="AddPunch" method="post">
                    <input type="hidden" name="employeeId" value="@Model.EmployeeId" />
                    <input type="hidden" name="date" value="@Model.Date.ToString("yyyy-MM-dd")" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tipo de Evento Faltante</label>
                        <select name="type" class="form-select form-select-lg" required>
                            <option value="1">🟢 Entrada de Turno (Clock In)</option>
                            <option value="2">☕ Salida a Café (Coffee Start)</option>
                            <option value="3">☕ Regreso de Café (Coffee End)</option>
                            <option value="4">🍲 Salida a Almuerzo (Lunch Start)</option>
                            <option value="5">🍲 Regreso de Almuerzo (Lunch End)</option>
                            <option value="6">🔴 Salida de Turno (Clock Out)</option>
                            <option value="7">🚶 Salida a Diligencia Personal (Personal Start)</option>
                            <option value="8">🚶 Regreso de Diligencia Personal (Personal End)</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Hora en que Ocurrió</label>
                        <input type="time" name="time" class="form-control form-control-lg" required />
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Justificación / Motivo del Ajuste</label>
                        <textarea name="justification" class="form-control" rows="3"
                                  placeholder="Ej: El colaborador olvidó marcar el regreso de café; confirmado por supervisor de área." required></textarea>
                    </div>

                    <button type="submit" class="btn btn-success btn-lg w-100 fw-bold">
                        💾 Registrar Marca Faltante
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>