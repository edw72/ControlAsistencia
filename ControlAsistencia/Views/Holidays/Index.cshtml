@model IEnumerable<ControlAsistencia.Models.Holiday>
@{
    ViewData["Title"] = "Calendario de Días Feriados";
}

<div class="container py-4" style="max-width: 950px;">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            ✔ @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            ⚠️ @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom gap-3">
        <div>
            <h2 class="h3 fw-bold mb-0">🎉 Calendario de Días Feriados</h2>
            <span class="text-muted">En estas fechas y en domingos, todo el trabajo se liquida 100% como Horas Extras</span>
        </div>
        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary">
            ⬅ Volver al Panel
        </a>
    </div>

    <div class="row g-4">
        <!-- Formulario para agregar nuevo feriado -->
        <div class="col-md-5">
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <h5 class="fw-bold mb-3">➕ Registrar Feriado</h5>
                <form asp-action="Create" method="post">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Fecha del Feriado</label>
                        <input type="date" name="Date" class="form-control form-control-lg" required />
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Nombre / Motivo</label>
                        <input type="text" name="Name" class="form-control form-control-lg"
                               placeholder="Ej: Navidad, Jueves Santo" required />
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold">
                        💾 Guardar Feriado
                    </button>
                </form>
            </div>
        </div>

        <!-- Lista de feriados registrados con opción de Editar -->
        <div class="col-md-7">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-white py-3 border-0">
                    <h5 class="card-title fw-bold mb-0">Feriados Configurados</h5>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Fecha</th>
                                <th>Feriado</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Any())
                            {
                                <tr>
                                    <td colspan="3" class="text-center text-muted py-4">
                                        No hay días feriados registrados.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="fw-bold">@item.Date.ToString("ddd dd/MM/yyyy")</td>
                                        <td>
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2 fs-6">
                                                🎉 @item.Name
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            <div class="btn-group btn-group-sm">
                                                <!-- Botón para Editar Feriado -->
                                                <button type="button" class="btn btn-outline-primary"
                                                        data-bs-toggle="modal" data-bs-target="#editModal-@item.Id" title="Editar fecha o nombre">
                                                    ✏
                                                </button>

                                                <!-- Botón para Eliminar Feriado -->
                                                <form asp-action="Delete" method="post" class="d-inline"
                                                      onsubmit="return confirm('¿Eliminar este día feriado?');">
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <button type="submit" class="btn btn-outline-danger" title="Eliminar">
                                                        🗑
                                                    </button>
                                                </form>
                                            </div>

                                            <!-- Modal de Edición de Feriado -->
                                            <div class="modal fade text-start" id="editModal-@item.Id" tabindex="-1">
                                                <div class="modal-dialog modal-dialog-centered">
                                                    <div class="modal-content rounded-4 border-0 shadow">
                                                        <form asp-action="Edit" method="post">
                                                            <div class="modal-header border-0 pb-0">
                                                                <h5 class="modal-title fw-bold">Editar Feriado</h5>
                                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                            </div>
                                                            <div class="modal-body">
                                                                <input type="hidden" name="id" value="@item.Id" />

                                                                <div class="mb-3">
                                                                    <label class="form-label fw-semibold">Fecha</label>
                                                                    <input type="date" name="date" class="form-control form-control-lg"
                                                                           value="@item.Date.ToString("yyyy-MM-dd")" required />
                                                                </div>

                                                                <div class="mb-3">
                                                                    <label class="form-label fw-semibold">Nombre / Motivo</label>
                                                                    <input type="text" name="name" class="form-control form-control-lg"
                                                                           value="@item.Name" required />
                                                                </div>
                                                            </div>
                                                            <div class="modal-footer border-0">
                                                                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                                                                <button type="submit" class="btn btn-primary btn-sm fw-bold">Actualizar Feriado</button>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>